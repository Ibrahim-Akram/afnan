# Copy to .env for local dev (never commit .env). On Oxygen, set these in the
# Hydrogen storefront's environment variables instead.
SESSION_SECRET="change-me"

# Leave the Shopify values empty to run on the built-in Afnan mock catalogue.
PUBLIC_STORE_DOMAIN=""
PUBLIC_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_ID=""
PRIVATE_STOREFRONT_API_TOKEN=""
PUBLIC_CHECKOUT_DOMAIN=""
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""
SHOP_ID=""
